# ============================================================
# Fennr Studio — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================

# ----- Email (Resend) -----
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered
CONTACT_TO_EMAIL=hello@example.com
# From address. Until you verify a domain in Resend, use the test sender
# below — it only delivers to the address you signed up to Resend with.
#   fennr <onboarding@resend.dev>
# After verifying your domain, switch to e.g. fennr <hello@example.com>
CONTACT_FROM_EMAIL=fennr <onboarding@resend.dev>

# ----- Supabase, server side (SECRET) -----
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — bypasses Row Level Security.
# Server only. Never expose this to the browser, never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# ----- Supabase, browser side (public) -----
# Safe to expose ONLY because Row Level Security is enabled on every table
# with no policies, which blocks the anon key outright. See supabase-setup.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# ----- Admin access -----
# Comma-separated Google accounts allowed into /admin. Anyone not listed is
# denied, and an empty value denies everyone (fails closed).
ADMIN_EMAILS=you@example.com,teammate@example.com

# ----- Cron -----
# Secret for the daily follow-up digest. Any long random string.
# Vercel Cron sends it as "Authorization: Bearer <this>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# Used for the "Open dashboard" link in the digest email.
SITE_URL=https://www.example.com
